# Copy to .env and fill in. Every variable below is read by the service that
# needs it; unset variables fall back to the defaults shown.

# ==== API server (server/main.py) ==========================================
# llama_cpp = real GGUF engine, mock = no model (protocol tests / CI)
BACKEND=llama_cpp
MODEL_PATH=model/extra-code-30m-q4_k_m.gguf
MODEL_NAME=extra-code-30m
MODEL_ALIASES=default

# inference
N_CTX=1024
N_THREADS=4
N_GPU_LAYERS=0
N_BATCH=256
CHAT_TEMPLATE=chatml
MOCK_DELAY_MS=0

# sampling defaults
DEFAULT_MAX_TOKENS=256
MAX_TOKENS_CAP=512
DEFAULT_TEMPERATURE=0.7
DEFAULT_TOP_P=0.9
DEFAULT_TOP_K=40
DEFAULT_REPEAT_PENALTY=1.1

# scheduling
MAX_CONCURRENT=1
QUEUE_TIMEOUT_S=10
GENERATION_TIMEOUT_S=60
SHUTDOWN_TIMEOUT_S=30

# auth
API_KEY=change-me-now
API_DB_PATH=server/data/keys.db
API_KEY_PEPPER=change-me-in-production
DEFAULT_RPM=60
DEFAULT_TPM=20000
DEFAULT_KEY_MAX_TOKENS=512

# ops
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
LOG_PROMPTS=false

# ==== Telegram bot (bot/main.py) ==========================================
BOT_TOKEN=
API_BASE_URL=http://127.0.0.1:8000
# API_KEY above is reused by the bot; keep them equal.
DEFAULT_MODEL=extra-code-30m
MAX_CONTEXT_MESSAGES=10
MAX_TOKENS=512
TEMPERATURE=0.7
TOP_P=0.9
SYSTEM_PROMPT=Ты компактная локальная модель Extra code. Отвечай кратко и по делу.
BOT_DB_PATH=bot/data/chats.db
RATE_LIMIT_PER_MIN=12
STREAM_EDITS=true
REQUEST_TIMEOUT_S=120
# mention = only when @bot is used or the bot is replied to; all = every message; off = private chats only
GROUP_MODE=mention

# ==== llama-server (accelerated profile, deploy/docker-compose.yml) ========
LLAMA_API_KEY=local-key
