[Unit]
Description=Extra code OpenAI-compatible API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=extracode
Group=extracode
WorkingDirectory=/opt/extra-code
EnvironmentFile=/etc/extra-code/api.env
ExecStart=/opt/extra-code/.venv/bin/uvicorn server.main:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers
Restart=always
RestartSec=2
TimeoutStopSec=45
KillSignal=SIGTERM
LimitNOFILE=65536
MemoryMax=2G
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/extra-code/server/data /var/lib/extra-code
StateDirectory=extra-code

[Install]
WantedBy=multi-user.target
